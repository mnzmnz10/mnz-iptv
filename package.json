{
  "name": "mnz-iptv",
  "version": "1.0.3",
  "description": "MNZ IPTV — Xtream Codes player (Electron + mpv)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mnz.iptv",
    "productName": "MNZ IPTV",
    "files": [
      "src/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mnzmnz10",
        "repo": "mnz-iptv"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
